Accept: application/taxii+json;version=2.1
Content-Type: application/taxii+json;version=2.1

{
	"objects": [
		{
			"type": "indicator",
			"spec_version": "2.1",
			"id": "indicator--d81f86b9-975b-4c0b-875e-810c5ad45a4f",
